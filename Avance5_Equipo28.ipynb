    {
      "cell_type": "markdown",
      "source": [
        "###Construcción de Modelo 1: **Procesos Gaussianos**"
      ],
      "metadata": {
        "id": "ib4jdVvWiRmD"
      },
      "id": "ib4jdVvWiRmD"
    },
    {
      "cell_type": "markdown",
      "source": [
        "Definir features"
      ],
      "metadata": {
        "id": "EQtwGUTv0UpP"
      },
      "id": "EQtwGUTv0UpP"
    },
    {
      "cell_type": "code",
      "source": [
        "features = [\n",
        "    \"tipo_cambio_usd_mxn\",\n",
        "    \"evento_exportacion\",\n",
        "    \"inspeccion_intensificada\",\n",
        "    \"cierre_exportacion\",\n",
        "    \"mes_sin\",\n",
        "    \"mes_cos\",\n",
        "    \"indice_demanda_exportacion\",\n",
        "    \"demanda_lag1\",\n",
        "    \"demanda_lag12\"\n",
        "]\n",
        "\n",
        "X = df_final[features]\n",
        "y = df_final[\"y\"]"
      ],
      "metadata": {
        "id": "zwu3I6nx0RxG"
      },
      "id": "zwu3I6nx0RxG",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Split temporal (80% train, 20% test)"
      ],
      "metadata": {
        "id": "vQJ_Tl6l0fAx"
      },
      "id": "vQJ_Tl6l0fAx"
    },
    {
      "cell_type": "code",
      "source": [
        "split = int(len(df_final) * 0.8)\n",
        "\n",
        "X_train, X_test = X.iloc[:split], X.iloc[split:]\n",
        "y_train, y_test = y.iloc[:split], y.iloc[split:]"
      ],
      "metadata": {
        "id": "PgKCcLNn0mBc"
      },
      "id": "PgKCcLNn0mBc",
      "execution_count": null,
      "outputs": []
